<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Replace <Your Full Name> with your name here  -->
    <title>Tong An Huy's Weekly Readings</title>
    
    <!-- Include your favicon here -->
    <link rel="icon" href="/images/logo.png">

    <!-- Including Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/style.css">
      
</head>
<body>
    <div class="container mx-auto min-vh-100 d-flex flex-column">

<%- include('partials/header') %>

<!-- Main content -->
<main class="home-main">
    
    <!-- Your profile-->
    <aside id="profile">
        <div>
            <img src="/images/profile.png" alt="my profile picture" height="250" >
        </div>
        <div>
            <div class="mb-4">
                <span>Hi, I'm</span>
                <h1>Tong An Huy</h1>
            </div>
            <div>
                <h2>s4197993</h2>
                <h2>tong.huy@rmit.edu.vn</h2>
            </div>
        </div>
    </aside>
    
    <!-- The reading list is shown here-->
    <section id="reading-list">
        <h2>Recommended <b>READING LIST</b></h2>

        <!-- Refresh button: clicking it sends a POST request to "/" -->
        <form method="POST" action="/">
            <button id="refresh-btn" type="submit">Refresh</button>
        </form>
        <% if (dayBoxes.length === 0) { %>
            <p>No reading list yet. Please run the seed script first.</p>
        <% } else { %>
            <% for (const box of dayBoxes) { %>
                <h3><%= box.dayLabel %></h3>
                <% for (const book of box.booksForThisDay) { %>
                    <%- include('partials/book-card', { book }) %>
                <% } %>
            <% } %>
        <% } %>
    </section> 
</main>
    
<%- include('partials/footer') %>
</div>


<!-- Including Boostrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"
  integrity="sha384-HwwvtgBNo3bZJJLYd8oVXjrBZt8cqVSpeBNS5n7C8IVInixGAoxmnlMuBnhbgrkm" crossorigin="anonymous"></script>
<script src="/js/main.js"></script>
</body>
</html>
