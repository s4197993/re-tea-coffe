<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Replace <Your Full Name> with your name here  -->
    <title><%= book.title %> - Tong An Huy's Weekly Readings</title>
    
    <!-- Include your favicon here -->
    <link rel="icon" href="/images/logo.png">

    <!-- Including Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/style.css">   
</head>
<body>

<%- include('partials/header') %>

<!-- Breadcrumb: shows Home Page > current book title -->
<nav class="crumb">
    <a href="/">Home Page</a> &gt;
    <a href="/book/<%= book.title %>"><%= book.title %></a>
</nav>

<!-- Main content-->
<main>
    <!-- Book details-->
    <div class="book-hero" role="img" aria-label="<%= book.title %> cover" style="background-image: url('<%= book.image %>');">
        <h1><%= book.title %></h1>
        <p>By <%= book.author %></p>
        <p><%= book.description %></p>
        <p><%= book.category %> | <%= book.year %></p>
    </div>

    <!-- Related books in the same category -->
    <section>
        <p>Related Books</p>
        <% for (const book of related) { %>
            <%- include('partials/related-book-card', { book }) %>
        <% } %>
    </section>

    <!-- Back button here -->
    
      <button id="btn-back" type="button">Back</button>
    
  </main>
    
<%- include('partials/footer') %>
    </div>

<!-- Including Boostrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"
  integrity="sha384-HwwvtgBNo3bZJJLYd8oVXjrBZt8cqVSpeBNS5n7C8IVInixGAoxmnlMuBnhbgrkm" crossorigin="anonymous"></script>
<script src="/js/main.js"></script>
</body>
</html>
